LITELLM_MASTER_KEY=sk-replace-this-with-a-secure-random-string
LITELLM_PORT=4000

# LiteLLM automatically uses DATABASE_URL to store customer API keys and track token usage/billing
DATABASE_URL=postgresql://your_db_user:your_db_password@host.docker.internal:5432/litellm

# ── vLLM API Configuration ────────────────────────────────────────────────────
# vLLM exposes an OpenAI-compatible API — no real API key is required
VLLM_API_KEY=not-needed

# Chat model (vLLM container — default port 8000)
VLLM_API_BASE=http://host.docker.internal:8000/v1
QWEN_MODEL_NAME=qwen
VLLM_CHAT_MODEL=openai/qwen

# Embedding model (vLLM embed container — default port 8001)
VLLM_EMBED_API_BASE=http://host.docker.internal:8001/v1
EMBEDDINGS_MODEL_NAME=embeddings
VLLM_EMBED_MODEL=openai/nomic-embed-text
