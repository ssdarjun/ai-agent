# =============================================================================
# vLLM Environment Variables — EXAMPLE / TEMPLATE
# Copy this to .env and fill in your values
# =============================================================================

# ── Shared ────────────────────────────────────────────────────────────────────
HF_TOKEN=

# ── Chat + Document Generation: Qwen2.5-7B-Instruct ─────────────────────────
# Purpose: Generate SOPs, recommendation letters, reports, summaries
VLLM_QWEN_PORT=8000
VLLM_QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_QWEN_ALIAS=qwen
VLLM_QWEN_MAX_LEN=8192
VLLM_QWEN_GPU_MEM=0.40

# ── Vision + OCR: Qwen2.5-VL-7B-Instruct ────────────────────────────────────
# Purpose: Passport / ID card scanning, extracting personal info from images & PDFs
VLLM_VISION_PORT=8002
VLLM_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VLLM_VISION_ALIAS=qwen-vision
VLLM_VISION_MAX_LEN=4096
VLLM_VISION_GPU_MEM=0.45
VLLM_VISION_MAX_IMAGES=5

# ── Embedding Model: nomic-embed-text-v1 ─────────────────────────────────────
# Purpose: Semantic search over student profiles, document similarity
VLLM_EMBED_PORT=8001
VLLM_EMBED_MODEL=nomic-ai/nomic-embed-text-v1
VLLM_EMBED_ALIAS=nomic-embed-text
VLLM_EMBED_GPU_MEM=0.10

# =============================================================================
# TEMPLATE — copy this block to add a new model
# =============================================================================
# VLLM_NEWMODEL_PORT=80XX
# VLLM_NEWMODEL_MODEL=organization/model-name
# VLLM_NEWMODEL_ALIAS=short-name
# VLLM_NEWMODEL_MAX_LEN=4096
# VLLM_NEWMODEL_GPU_MEM=0.XX
# =============================================================================
