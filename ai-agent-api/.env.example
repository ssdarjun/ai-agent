# Use host.docker.internal if connecting to another local docker-compose project from within a docker container on Windows/Mac
DATABASE_URL=postgresql://your_username:your_password@host.docker.internal:5432/vectordb

# Connect to the LiteLLM API Gateway instead of Ollama directly
LITELLM_BASE_URL=http://host.docker.internal:4000/v1
LITELLM_MASTER_KEY=sk-replace-this-with-your-litellm-master-key

# External APIs
API_URL=https://fakestoreapi.com/products

# Port Configuration
BACKEND_PORT=8000
